package="CH340UPS"
version="@VERSION@"
os_min_ver="7.0-40000"
arch="@ARCH@"
maintainer="romangrechin"
maintainer_url="https://github.com/romangrechin/synology-ch340-ups"
displayname="CH340 USB UPS Driver"
description="Adds the NUT blazer_ser serial driver so DSM can monitor a Megatec/Q1 UPS attached through a CH340/CH341 USB-serial bridge instead of a USB-HID interface. Reapplies itself after DSM updates. Tested with an Ippon Back Basic 1050 Euro."
thirdparty="yes"
silent_install="yes"
silent_upgrade="yes"
silent_uninstall="yes"
