diff --git a/drivers/blazer_ser.c b/drivers/blazer_ser.c
index 629bec2..7f5a7d5 100644
--- a/drivers/blazer_ser.c
+++ b/drivers/blazer_ser.c
@@ -21,6 +21,9 @@
  * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA 02111-1307 USA
  */
 
+#include <glob.h>
+#include <string.h>
+
 #include "main.h"
 #include "serial.h"
 #include "blazer.h"
@@ -136,6 +139,28 @@ void upsdrv_initups(void)
 	/*
 	 * Open and lock the serial port and set the speed to 2400 baud.
 	 */
+	/* DSM forces "port = auto"; resolve it to the real serial port. The socket
+	 * name comes from device_name in main.c, so it stays unaffected. */
+	if (!strcmp(device_path, "auto")) {
+		glob_t	gl;
+		char	*found = NULL;
+
+		if (!glob("/dev/ttyUSB*", 0, NULL, &gl)) {
+			if (gl.gl_pathc > 0) {
+				found = xstrdup(gl.gl_pathv[0]);
+			}
+
+			globfree(&gl);
+		}
+
+		if (!found) {
+			fatalx(EXIT_FAILURE, "port 'auto': no /dev/ttyUSB* device found");
+		}
+
+		upslogx(LOG_INFO, "port 'auto' resolved to %s", found);
+		device_path = found;
+	}
+
 	upsfd = ser_open(device_path);
 	ser_set_speed(upsfd, device_path, B2400);
 
