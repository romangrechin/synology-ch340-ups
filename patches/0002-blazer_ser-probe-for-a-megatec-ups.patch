+/* Only CH340/CH341 bridges are probed, so adapters from other vendors are
+ * never written to. */
+static int is_bridge_port(const char *path)
+{
+	const char	*name = strrchr(path, '/');
+	char		sysfs[256], vid[16];
+	FILE		*fh;
+
+	name = name ? name + 1 : path;
+	snprintf(sysfs, sizeof(sysfs),
+		"/sys/class/tty/%s/device/../../idVendor", name);
+
+	fh = fopen(sysfs, "r");
+
+	if (!fh) {
+		return 0;
+	}
+
+	if (!fgets(vid, sizeof(vid), fh)) {
+		fclose(fh);
+		return 0;
+	}
+
+	fclose(fh);
+	vid[strcspn(vid, "\r\n")] = '\0';
+
+	return !strcmp(vid, "1a86") || !strcmp(vid, "4348");
+}
+
+/* CH340/CH341 carry Arduinos and plain COM adapters too, so accept a port
+ * only if it answers the Megatec status query. */
+static int is_megatec_port(const char *path)
+{
+	int		fd, ret = 0, tries;
+	struct termios	tio;
+	char		buf[64];
+
+	fd = open(path, O_RDWR | O_NOCTTY | O_NONBLOCK);
+
+	if (fd < 0) {
+		upsdebugx(2, "%s: open failed: %s", path, strerror(errno));
+		return 0;
+	}
+
+	/* Leave the port alone if another program is holding it. */
+	if (flock(fd, LOCK_EX | LOCK_NB) != 0) {
+		upsdebugx(2, "%s: in use, skipped", path);
+		close(fd);
+		return 0;
+	}
+
+	memset(&tio, 0, sizeof(tio));
+	tio.c_cflag = CS8 | CREAD | CLOCAL;
+	tio.c_cc[VMIN] = 0;
+	tio.c_cc[VTIME] = 0;
+	cfsetispeed(&tio, B2400);
+	cfsetospeed(&tio, B2400);
+
+	if (tcsetattr(fd, TCSANOW, &tio)) {
+		upsdebugx(2, "%s: tcsetattr failed: %s", path, strerror(errno));
+		close(fd);
+		return 0;
+	}
+
+	usleep(100000);
+
+	for (tries = 0; tries < 5 && !ret; tries++) {
+		size_t	len = 0;
+		int	waited;
+
+		buf[0] = '\0';
+		tcflush(fd, TCIOFLUSH);
+
+		if (write(fd, "Q1\r", 3) != 3) {
+			upsdebugx(2, "%s: write failed: %s", path, strerror(errno));
+			break;
+		}
+
+		/* the full Q1 reply needs about 200 ms at 2400 baud */
+		for (waited = 0; waited < 1000 && !ret; waited += 50) {
+			ssize_t	got;
+
+			usleep(50000);
+
+			got = read(fd, buf + len, sizeof(buf) - 1 - len);
+
+			if (got > 0) {
+				len += (size_t)got;
+				buf[len] = '\0';
+
+				if (buf[0] == '(' && memchr(buf, '\r', len)) {
+					ret = 1;
+				}
+			}
+
+			if (len >= sizeof(buf) - 1) {
+				break;
+			}
+		}
+
+		upsdebugx(2, "%s: attempt %d read %d byte(s): %s",
+			path, tries + 1, (int)len, buf);
+	}
+
+	close(fd);
+	return ret;
+}
